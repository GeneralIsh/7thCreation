# ──────────────────────────────────────────────
# 7th Creation Studio — Environment Variables
# ──────────────────────────────────────────────

# Resend API key for quote form email delivery
# Get yours at: https://resend.com
# Add your domain (7thcreation.com) in Resend → Domains
# Then set this in Vercel: Project Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 measurement ID used for website and lead event tracking.
# Set this in the production deployment only after the GA4 property is created.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads tag ID for paid-search measurement and conversion setup.
# 7th Creation account: AW-18500578951
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18500578951
